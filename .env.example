# Copy this file to .env and adjust the values:  cp .env.example .env
# .env is git-ignored. Never commit real API keys.

# --- Model provider -------------------------------------------------------
# Option A (default): local Ollama on your computer. Free, and NO API key needed.
# One Ollama server runs all models (primary, secondary and auditor).
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://localhost:11434
MODEL_API_KEY=

# Option B: Ollama Cloud (models run on ollama.com instead of your computer).
#   1. Sign in at https://ollama.com and create a key at https://ollama.com/settings/keys
#   2. Use the lines below instead of the Option A lines above.
#   One key works for ALL models, so there is only one MODEL_API_KEY.
#   Ollama Cloud does NOT offer llama3.2 or qwen2.5:3b: pick model names from
#   the list at  curl https://ollama.com/api/tags  (e.g. gpt-oss:20b, gemma4:31b).
# MODEL_PROVIDER=ollama
# MODEL_BASE_URL=https://ollama.com
# MODEL_API_KEY=paste-your-ollama-api-key-here
# PRIMARY_MODEL=gpt-oss:20b
# SECONDARY_MODEL=gemma4:31b

# For an OpenAI-compatible hosted API use MODEL_PROVIDER=openai and install its
# LangChain package first:  pip install langchain-openai

# --- Models -----------------------------------------------------------------
PRIMARY_MODEL=llama3.2
SECONDARY_MODEL=qwen2.5:3b
# Leave empty to use PRIMARY_MODEL. A stronger auditor (e.g. qwen2.5:7b)
# usually gives more reliable audit scores, but is slower.
AUDITOR_MODEL=

# --- Behaviour --------------------------------------------------------------
# Cosine similarity (0-1) at or above which the two answers count as "agreeing".
AGREEMENT_THRESHOLD=0.80
# How many previous chat messages are sent to the models with each question.
HISTORY_MESSAGES=6

# --- Wikipedia --------------------------------------------------------------
# Wikimedia asks every API client to identify itself with contact details.
# Replace the placeholder with your own contact (e.g. your repo URL).
WIKI_USER_AGENT=ModelProof-py/0.1 (AI course project; contact: <your contact>)
