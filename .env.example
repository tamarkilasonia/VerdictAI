# Copy this file to .env and fill in the two API keys:  cp .env.example .env
# .env is git-ignored. Never commit real API keys, and never paste them in a chat.
#
# VerdictAi uses two AI services. Both have a free tier, no credit card needed.

# --- AI 1: Google Gemini (writes the main answer) ---------------------------
# Free key: https://aistudio.google.com  ->  "Get API key"
PRIMARY_API_KEY=
PRIMARY_MODEL=gemini-3.1-flash-lite
PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- AI 2: Groq (second opinion + the auditor) -------------------------------
# Free key: https://console.groq.com  ->  "API Keys"  ->  "Create API Key"
SECONDARY_API_KEY=
SECONDARY_MODEL=qwen/qwen3.8-27b
AUDITOR_MODEL=openai/gpt-oss-120b
SECONDARY_BASE_URL=https://api.groq.com/openai/v1

# Model names change over time. If a name stops working, pick a current one in
# Google AI Studio or in the Groq console and paste it here.

# --- Behaviour ---------------------------------------------------------------
# Cosine similarity (0-1) at or above which the two answers count as "agreeing".
AGREEMENT_THRESHOLD=0.80
# How many previous chat messages are sent to the models with each question.
HISTORY_MESSAGES=6

# --- Wikipedia ---------------------------------------------------------------
# Wikimedia asks every API client to identify itself with contact details.
# Replace the placeholder with your own contact (e.g. your repo URL).
WIKI_USER_AGENT=VerdictAi/0.1 (AI course project; contact: <your contact>)
