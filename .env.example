# Copy this file to .env and adjust the values:  cp .env.example .env
# .env is git-ignored. Never commit real API keys.

# --- Model provider -------------------------------------------------------
# "ollama" for a local Ollama server. For a hosted OpenAI-compatible API use
# "openai" and install its LangChain package:  pip install langchain-openai
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://localhost:11434
# Local Ollama needs no key. For a hosted provider, put your key here.
MODEL_API_KEY=

# --- Models -----------------------------------------------------------------
PRIMARY_MODEL=llama3.2
SECONDARY_MODEL=qwen2.5:3b
# Leave empty to use PRIMARY_MODEL. A stronger auditor (e.g. qwen2.5:7b)
# usually gives more reliable audit scores, but is slower.
AUDITOR_MODEL=

# --- Behaviour --------------------------------------------------------------
# Cosine similarity (0-1) at or above which the two answers count as "agreeing".
AGREEMENT_THRESHOLD=0.80
# How many previous chat messages are sent to the models with each question.
HISTORY_MESSAGES=6

# --- Wikipedia --------------------------------------------------------------
# Wikimedia asks every API client to identify itself with contact details.
# Replace the placeholder with your own contact (e.g. your repo URL).
WIKI_USER_AGENT=ModelProof-py/0.1 (AI course project; contact: <your contact>)
